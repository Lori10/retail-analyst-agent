# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GEMINI_API_KEY=your-ai-studio-key

# Optional (defaults shown)
# GEMINI_MODEL=gemini-3.6-flash
# BQ_MAX_BYTES_BILLED=1000000000
# BQ_ROW_LIMIT=500
# BQ_QUERY_TIMEOUT_SECONDS=30
# REPORTS_DATABASE_URL=postgresql://retail_agent:retail_agent@localhost:5432/retail_agent_reports
# TRACE_LOG_DESTINATION=stderr
# AGENT_MCP_SERVERS=mcp_servers.example.json   # external MCP servers whose tools the agent loads

# Optional: LangSmith conversation-level tracing (docs/design.md §3 Observability).
# Free Developer tier, no credit card required — https://smith.langchain.com.
# Tracing is simply off if these are unset; nothing else in this app changes.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=retail-agent
