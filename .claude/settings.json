{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(npx @fission-ai/openspec@1.14.1 list:*)",
      "Bash(npx @fission-ai/openspec@1.14.1 show:*)",
      "Bash(npx @fission-ai/openspec@1.14.1 validate:*)",
      "Bash(npx @fission-ai/openspec@1.14.1 status:*)",
      "Bash(.claude/skills/verify/check.sh:*)",
      "mcp__retail-analyst__get_schema",
      "mcp__retail-analyst__list_reports",
      "mcp__retail-analyst__run_query",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push:*)",
      "Bash(gh pr create:*)", "Bash(gh pr view:*)", "Bash(gh pr checks:*)", "Bash(gh pr ready:*)",
      "Bash(gh run list:*)", "Bash(gh run view:*)", "Bash(gh run watch:*)"
    ],
    "ask": [
      "mcp__retail-analyst__confirm_delete"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(bq rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_git.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pin_openspec.sh" }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_deps.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint_py.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_tests.sh", "timeout": 320 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_context.sh" }
        ]
      }
    ]
  }
}
